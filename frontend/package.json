    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.67.0",
    "next": "16.4.3",
    "pdfjs-dist": "4.10.38",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-pdf-highlighter-extended": "8.1.0",
    "rehype-sanitize": "6.0.0",
