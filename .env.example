# ==== BiblioFlow 設定 ====
# cp .env.example .env の後、change-me-* をすべて置き換えること。
# シークレット生成: openssl rand -hex 32

# --- PostgreSQL ---
POSTGRES_USER=biblioflow
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=biblioflow
# DATABASE_URL / TEST_DATABASE_URL / REDIS_URL は docker-compose.yml が
# 上記 POSTGRES_* と REDIS_PASSWORD から自動で組み立てる（ここには書かない）。

# --- Redis ---
REDIS_PASSWORD=change-me-redis-password

# --- 認証 ---
# 32バイト以上必須（起動時に検証される）。例: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes
# セッション有効期限（分）
JWT_EXPIRE_MINUTES=720
# ブラウザで開く URL の一覧（カンマ区切り、末尾スラッシュなし）。CORS と CSRF(Origin検査) の許可リストを兼ねる。
# LAN なら http://<ホスト>:<FRONTEND_PORT>、Tailscale / Cloudflare なら https://<公開ホスト名> を追加する。
# Cookie の Secure 属性と HSTS はリクエストが https かどうかで自動的に決まる（設定不要）。
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 公開サインアップを許可するか（通常は false。ユーザーは CLI で作成）
ALLOW_REGISTRATION=false
# /docs を有効にするか（本番では false 推奨）
ENABLE_DOCS=false

# --- ストレージ ---
MAX_UPLOAD_MB=50
LIBRARY_ROOT=/data/library
WATCH_DIR=/data/watch
# 自動エクスポート（設定 > 自動エクスポート）の出力先。EXPORT_DIR/{workspace_slug}/{ファイル名}。ホスト側は ./data/exports
EXPORT_DIR=/data/exports
# 使用可能: {year} {identifier} {slug_title}。拡張子は .pdf のみ。
FILENAME_TEMPLATE={year}/{identifier}_{slug_title}.pdf

# --- 外部メタデータAPI / 取り込み（Phase 2）---
# CrossRef polite pool 用の連絡先（任意。設定すると User-Agent に mailto が付く）
CROSSREF_MAILTO=
# Semantic Scholar API キー（任意。未設定だと共有レートリミットになる）
SEMANTIC_SCHOLAR_API_KEY=
# 外部HTTPのタイムアウト（秒）
EXTERNAL_HTTP_TIMEOUT=10
# Watch Folder（WATCH_DIR/{workspace_slug}/*.pdf）のスキャン間隔（秒）
WATCH_POLL_SECONDS=10
# URL からの PDF 取り込み（POST /papers/import-url）。既定は無効（無効時は 404）。
# 出版社サイトの多くはサーバーからの取得を拒否するため、当面は upload / Watch Folder を使う。
URL_IMPORT_ENABLED=false

# --- Embedding（意味検索）---
# 既定は none（何も落とさず、検索はキーワードと部分一致だけ）。local にすることが「モデルの取得への同意」になる。
# none  : embedding を作らない。小さいマシン向け。あとから local にして `docker compose up -d` すれば有効になる。
# local : biblioflow-embedder（BAAI/bge-m3 を ONNX Runtime の CPU で動かす）。biblioflow-model-init が裏で
#         int8 のモデル（約 0.6 GB、このリポジトリの GitHub Release、MIT）を一度だけ取得して sha256 を検証し、`models` ボリュームに
#         置く。取得中も起動は待たない。終わると embedder が読み込み、worker が既存の論文の embedding も自動で作る。
#         メモリ約 2 GB を使う。論文の本文は外に出ない（取得するのはモデルだけ）。
# voyage / openai : 外部 API。論文の本文（チャンク）がそのプロバイダーに送られる。openai は EMBEDDING_BASE_URL で
#         OpenAI 互換のサーバー（Ollama・vLLM・TEI）にも向けられる。
EMBEDDING_PROVIDER=none
# local の精度。int8（既定、約 0.6 GB）は fp32 より約 3 倍速くメモリも少ない（近傍の一致 90%）。fp32 は Hugging Face の公式から約 2.3 GB を取得する（EMBEDDER_MEM_LIMIT を 4g 以上に）。
EMBEDDING_LOCAL_PRECISION=int8
# voyage / openai のとき（local では不要）。モデルの既定: voyage-3.5 / text-embedding-3-large（どちらも 1024 次元で呼ぶ）
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
# embedder コンテナの資源（local のとき）
EMBEDDER_MEM_LIMIT=3g
EMBEDDER_CPUS=4
EMBEDDER_THREADS=4
# model-init のメモリ上限（ファイルを流して sha256 を計算するだけなので 512m で足りる）
MODEL_INIT_MEM_LIMIT=512m
# 検索のクエリを embedding するときの待ち時間（秒）。超えるとキーワード検索だけで答える。
EMBEDDING_QUERY_TIMEOUT=2
# ベクトル検索の類似度（コサイン）の下限。0 なら絞らない。bge-m3 では無関係なクエリでも 0.41〜0.43 になるので 0.45。
SEARCH_MIN_SIMILARITY=0.45
EMBEDDING_DIM=1024

# --- LLM（チャット。Phase 3d）---
# 既定は無効（none）。有効にすると質問と論文の本文の一部が選んだプロバイダーに送られる（ollama なら外に出ない）。
# プロバイダーを選んでも必要な値（モデル・キー・LLM_API_BASE）が欠けていれば、API は警告をログに出してチャットを無効のまま起動する。
# none | anthropic | openai | gemini | ollama | openai_compatible
LLM_PROVIDER=none
# プロバイダーを選んだら必須。例: claude-sonnet-5-5 / gpt-4o-mini / gemini-2.5-flash / llama3.2
LLM_MODEL=
# anthropic / openai / gemini で必須。1Password を使うなら op://Vault/Item/credential のように書く。
LLM_API_KEY=
# ollama / openai_compatible で必須（例: http://host.docker.internal:11434）。
LLM_API_BASE=
# 画像（矩形選択の解説）用のモデル。空なら LLM_MODEL が画像に対応しているとみなす。
VISION_MODEL=
# 1 回の回答の最大トークン数、プロンプトに入れる論文チャンクの最大数。
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_CONTEXT_CHUNKS=8
# 全体のタイムアウトと、最初のトークンまでのタイムアウト（秒）。
LLM_TIMEOUT=60
LLM_FIRST_TOKEN_TIMEOUT=30
# 1 ユーザーあたりの 1 日の上限（リクエスト数・トークン数）。
LLM_DAILY_REQUESTS_PER_USER=200
LLM_DAILY_TOKENS_PER_USER=200000
# 会話の保存期間（日。最後のやりとりから数える）。0 なら削除しない。
CHAT_RETENTION_DAYS=90

# --- コンテナ / ネットワーク ---
# コンテナ内プロセスの UID/GID（bind mount した data/ の所有者に合わせる）
APP_UID=1000
APP_GID=1000
# ゲートウェイ（biblioflow-gateway）をホストに公開するアドレスとポート。これが唯一の公開ポート。
# 自分の PC だけ: 127.0.0.1 / LAN に公開: 0.0.0.0 / Tailscale・Cloudflare のみ: 127.0.0.1 のまま。
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
# フロントエンドが API へ転送する先（ビルド時に埋め込まれる。通常は変更不要）
API_INTERNAL_URL=http://biblioflow-api:8000

# 同じマシンで 2 つ目のインスタンス（開発と並べた本番など）を動かすときだけ設定する。
# BF_INSTANCE: コンテナ名とネットワーク名の接頭辞（biblioflow-* のまま。例: biblioflow-prod）
# COMPOSE_PROJECT_NAME: compose のプロジェクト名（ボリューム名とイメージ名が分かれる）
# FRONTEND_PORT も、もう一方と重ならない値にする。
# BF_INSTANCE=biblioflow-prod
# COMPOSE_PROJECT_NAME=biblioflow-prod
# 起動する profile（scripts/deploy.sh と docker compose up が使う）。例: cloudflare
# COMPOSE_PROFILES=cloudflare

# --- Cloudflare Tunnel（任意。docker compose --profile cloudflare up -d で起動）---
# Zero Trust > Networks > Tunnels で作成したトンネルのトークン。
# Public hostname のサービスは http://biblioflow-gateway:8081 を指定する（信頼リスナー。:8080 ではない）。
# CORS_ALLOWED_ORIGINS に https://<公開ホスト名> を追加する（ないとログイン時の Origin 検査で弾かれる）。
CLOUDFLARE_TUNNEL_TOKEN=

# --- Tailscale（任意。docker compose --profile tailscale up -d で起動）---
# Tailscale 管理画面で発行した auth key（初回のみ必要。状態は tailscale-state volume に残る）。
# 空のままならログ（docker compose logs biblioflow-tailscale）に出る認証 URL を開く。
TS_AUTHKEY=
# tailnet 上のホスト名。https://<TS_HOSTNAME>.<tailnet>.ts.net でアクセスできる。
# CORS_ALLOWED_ORIGINS にその URL を追加すること。
TS_HOSTNAME=biblioflow

# ==== このファイルには書かない変数（コマンドを動かすときだけ渡す）====
# 置き場は ~/.config/biblioflow/（scripts/dev-setup.sh が作る。LOCAL_DEV.md を参照）。
# 渡し方: scripts/with-env.sh <ファイル> -- <コマンド>（値は平文か 1Password の op://<vault>/<item>/<field>）。
#
# cloudflare.env — scripts/cloudflare-tunnel.sh / cloudflare-access.sh が使う。.env に入れるとアプリのコンテナに渡ってしまう。
#   CLOUDFLARE_API_TOKEN=
# mcp.env — biblioflow-mcp（mcp/）が使う。
#   BIBLIOFLOW_URL=http://localhost:3000
#   BIBLIOFLOW_TOKEN=bf_pat_xxxxxxxx
#   CF_ACCESS_CLIENT_ID=xxxxxxxx.access
#   CF_ACCESS_CLIENT_SECRET=xxxxxxxx
# scripts/backup.sh の環境変数（任意）
#   BACKUP_DIR=./backups
#   BACKUP_KEEP=14
# install.sh の環境変数（任意。README の Setup を参照）
#   BIBLIOFLOW_DIR=~/biblioflow  BIBLIOFLOW_PORT=3000  BIBLIOFLOW_REF=<tag>  BIBLIOFLOW_NO_START=1  BIBLIOFLOW_SEMANTIC_SEARCH=yes|no
# docker-compose.yml が組み立てる（書かない）: DATABASE_URL / TEST_DATABASE_URL / REDIS_URL / EMBEDDER_URL
# テスト用イメージのビルド時だけ: INSTALL_DEV=true docker compose build biblioflow-api
