# BiblioFlow gateway. The only service published to the host.
#
#   :8080  published (${BIND_ADDRESS}:${FRONTEND_PORT}). Untrusted clients: any
#          X-Forwarded-* they send is discarded; Caddy sets them from the socket.
#   :8081  NOT published. cloudflared only: the client IP comes from CF-Connecting-IP
#          (set by Cloudflare's edge, which overwrites any client-supplied value).
#   :8082  NOT published. tailscale only: the client IP comes from X-Forwarded-For
#          (tailscale serve overwrites it). CF-Connecting-IP is NOT trusted here,
#          because tailscale serve passes it through from the tailnet client.
{
	admin off
	auto_https off
	persist_config off

	servers :8081 {
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP
	}
	servers :8082 {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

(upstream_headers) {
	# Exactly one client IP, never an appended chain.
	header_up X-Forwarded-For {client_ip}
	# Already consumed by Caddy where trusted; never forward a client-supplied copy.
	header_up -CF-Connecting-IP
}

# Reject bodies over {args[0]} MiB with the same JSON 413 the API returns.
# No "Connection: close" here: with Caddy 2.11 it made the server close the socket while the
# client was still sending, and clients saw a reset instead of the 413 (about 4 in 10 requests).
(body_limit) {
	@too_large expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > {args[0]} * 1048576`
	handle @too_large {
		header Content-Type application/json
		respond `{"detail":"Request body too large"}` 413
	}
	request_body {
		max_size {args[0]}MiB
	}
}

(app) {
	# Access log (JSON on stdout -> `docker compose logs biblioflow-gateway`). Caddy redacts
	# Cookie / Set-Cookie / Authorization by default. client_ip is the resolved client address.
	log {
		output stdout
		format json
	}
	log_skip /gateway-healthz

	# Local health endpoint for the container healthcheck.
	handle /gateway-healthz {
		respond "ok" 200
	}

	# Body limits. A declared Content-Length over the limit is answered here with 413 before any
	# byte reaches the API (letting the API reject it mid-stream makes Caddy report a 502).
	# Chunked bodies are cut by request_body max_size, which also answers 413.
	# The API enforces the same limits itself (app/main.py), so these must stay in sync.

	# PDF upload: the only route that takes a large body (MAX_UPLOAD_MB, as in the API).
	handle /api/v1/papers/upload {
		import body_limit {$MAX_UPLOAD_MB:50}
		reverse_proxy biblioflow-api:8000 {
			import upstream_headers
		}
	}

	# Rest of the API: straight to FastAPI (no Next.js proxy, so no 30 s proxy timeout).
	# JSON bodies only; 4 MiB (notes are at most 500k characters).
	handle /api/* {
		import body_limit 4
		reverse_proxy biblioflow-api:8000 {
			import upstream_headers
			flush_interval -1  # server-sent events (POST /api/v1/chat) must not be buffered
		}
	}

	# Frontend: pages and static assets only (no server actions), so requests have no real body.
	handle {
		request_body {
			max_size 1MiB
		}
		reverse_proxy biblioflow-frontend:3000 {
			import upstream_headers
		}
	}
}

:8080 {
	import app
}

:8081 {
	import app
}

:8082 {
	import app
}
